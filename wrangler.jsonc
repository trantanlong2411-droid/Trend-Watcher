{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-watcher",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "TREND_JOURNAL",
        "class_name": "TrendJournal"
      }
    ]
  },
  "exports": {
    "TrendJournal": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
